/*
 * helloworld.c: simple test application
 *
 * This application configures UART 16550 to baud rate 9600.
 * PS7 UART (Zynq) is not initialized by this application, since
 * bootrom/bsp configures it to baud rate 115200
 *
 * ------------------------------------------------
 * | UART TYPE   BAUD RATE                        |
 * ------------------------------------------------
 *   uartns550   9600
 *   uartlite    Configurable only in HW design
 *   ps7_uart    115200 (configured by bootrom/bsp)
 */




/******************************************************************************
 * Zybo Z7-20 : AXI GPIO -> Pmod LED (JE) 제어 예제
 *
 *  - Pmod LED (4 LED) : JE1~JE4 -> bit[3:0]   (PMOD_LED_COUNT = 4)
 *  - Pmod 8LD (8 LED) : JE1~JE10 -> bit[7:0]  (PMOD_LED_COUNT = 8)
 *
 *  패턴 1) 전체 점멸  2) 이진 카운터  3) 좌우 왕복(Knight Rider)
 *  UART(115200 8N1)로 진행 상황 출력
 *
 *  Vitis Classic(XSA, DEVICE_ID) / Vitis Unified 2023.2+(SDT, BASEADDR)
 *  양쪽에서 빌드되도록 작성됨.
 ******************************************************************************/

#include "xparameters.h"
#include "xgpio.h"
#include "xstatus.h"
#include "xil_printf.h"
#include "sleep.h"

/* ---------------- 사용자 설정 ---------------- */
#define PMOD_LED_COUNT   4          /* Pmod LED = 4, Pmod 8LD = 8 */
#define LED_CHANNEL      1          /* AXI GPIO 채널 1 */
#define DELAY_US         150000     /* 패턴 간격 150 ms */

/* ---------------- 드라이버 ID (Classic / SDT 호환) ---------------- */
#ifdef SDT
  #define GPIO_ID  XPAR_AXI_GPIO_0_BASEADDR
#else
  #define GPIO_ID  XPAR_AXI_GPIO_0_DEVICE_ID
#endif

#define LED_MASK  ((1u << PMOD_LED_COUNT) - 1u)

static XGpio LedGpio;

static inline void led_write(u32 value)
{
    XGpio_DiscreteWrite(&LedGpio, LED_CHANNEL, value & LED_MASK);
}

/* 1) 전체 점멸 */
static void pattern_blink(int repeat)
{
    for (int i = 0; i < repeat; i++) {
        led_write(LED_MASK);
        usleep(DELAY_US * 2);
        led_write(0);
        usleep(DELAY_US * 2);
    }
}

/* 2) 이진 카운터 0 ~ 2^N-1 */
static void pattern_counter(void)
{
    for (u32 v = 0; v <= LED_MASK; v++) {
        led_write(v);
        usleep(DELAY_US);
    }
}

/* 3) 좌우 왕복 */
static void pattern_knight_rider(int repeat)
{
    for (int r = 0; r < repeat; r++) {
        for (int i = 0; i < PMOD_LED_COUNT; i++) {
            led_write(1u << i);
            usleep(DELAY_US);
        }
        for (int i = PMOD_LED_COUNT - 2; i > 0; i--) {
            led_write(1u << i);
            usleep(DELAY_US);
        }
    }
}

int main(void)
{
    int status;

    xil_printf("\r\n=== Zybo Z7-20 Pmod LED (JE) demo ===\r\n");

    status = XGpio_Initialize(&LedGpio, GPIO_ID);
    if (status != XST_SUCCESS) {
        xil_printf("ERROR: XGpio_Initialize failed (%d)\r\n", status);
        return XST_FAILURE;
    }

    /* 방향 설정: 0 = 출력 (C_ALL_OUTPUTS=1 이어도 명시적으로 설정) */
    XGpio_SetDataDirection(&LedGpio, LED_CHANNEL, 0x00000000);
    led_write(0);

    while (1) {
        xil_printf("Pattern: blink\r\n");
        pattern_blink(3);

        xil_printf("Pattern: binary counter\r\n");
        pattern_counter();

        xil_printf("Pattern: knight rider\r\n");
        pattern_knight_rider(3);
    }

    return XST_SUCCESS;   /* not reached */
}

